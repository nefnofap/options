# ──────────────────────────────────────────────────────────────────────────
# Aplus / Intel section — API keys & access control
# Copy to `.env.local` and fill in. Every key is OPTIONAL: any feature whose
# key is missing degrades gracefully (shows a "set <KEY>" notice instead of
# crashing). The free tiers below are enough to light up Macro + Sentiment.
# ──────────────────────────────────────────────────────────────────────────

# ── Auth — Discord OAuth (Auth.js / NextAuth v5) ──
# The whole app sits behind Discord login. You CANNOT sign in unless you're a
# member of DISCORD_GUILD_ID. Members get the FREE tier (dashboard + Macro +
# News Bias); members holding DISCORD_PREMIUM_ROLE_ID get PREMIUM (the rest of
# Intel + Pine export + GEX levels).
#
# AUTH_SECRET: session signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=
# Discord OAuth2 app — https://discord.com/developers/applications
# OAuth2 → add redirect: http://localhost:3000/api/auth/callback/discord (+ prod).
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Guild users MUST belong to in order to log in (Copy Server ID, dev mode on).
DISCORD_GUILD_ID=
# Role within that guild that grants the premium tier (Copy Role ID).
DISCORD_PREMIUM_ROLE_ID=

# FRED — https://fred.stlouisfed.org/docs/api/api_key.html  (free, instant)
# Powers the (free) Macro Analysis page: SOFR, rates, credit stress, VIX, CPI.
FRED_API_KEY=

# Finnhub — https://finnhub.io  (free tier)  — market news for sentiment.
FINNHUB_API_KEY=

# MarketAux — https://www.marketaux.com  (free tier, ~100 req/day)
# News for the Pre-Market Brief + sentiment.
MARKETAUX_API_KEY=

# TradingEconomics — https://tradingeconomics.com/api/  (free guest tier)
# Economic calendar for the Pre-Market Brief. Format: "key:secret" or guest:guest
TRADINGECONOMICS_KEY=guest:guest

# Twelve Data — https://twelvedata.com  (free tier, 8 req/min / 800 per day)
# OHLC for the Instruments tracker (RSI/MACD are computed locally from this).
TWELVE_DATA_API_KEY=

# TAAPI.io — https://taapi.io  (free tier, optional)
# If set, RSI/MACD come from TAAPI instead of local calc. Leave blank to use
# the built-in local indicators (recommended — no rate limits).
TAAPI_SECRET=

# EconPulse — https://econpulse.io  (demo key "demo" works for limited data)
ECONPULSE_KEY=demo

# Apify financial-news-sentiment actor — https://apify.com  (optional)
# If set, sentiment scores come from the AI actor instead of the local lexicon.
APIFY_TOKEN=
